DATABASE_URL=postgres://localhost:5433/handovr
SESSION_SECRET=change-me-to-a-long-random-string

# Where the app is reached. PayPal sends people back to this address after login.
APP_URL=http://127.0.0.1:3000

# PayPal sandbox app (developer.paypal.com, Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

ANTHROPIC_API_KEY=
HANDOVR_MODEL=claude-sonnet-5-5
KERNEL_API_KEY=

# A long random string. The uptime pinger calls /api/tick?key=<this> every 5 minutes.
TICK_SECRET=

# From the PayPal developer dashboard once a webhook is registered for the deployed app.
PAYPAL_WEBHOOK_ID=

# How long the client has to review before the work is approved automatically. 432000 is five days.
REVIEW_WINDOW_SECONDS=432000
# The model that tests the sites. Falls back to HANDOVR_MODEL.
HANDOVR_VERIFY_MODEL=claude-sonnet-5-5

# Notification emails go through a Zapier MCP server with the Gmail "Send Email" action. Leave the tool blank to log them instead.
ZAPIER_MCP_URL=
ZAPIER_EMAIL_TOOL=gmail_send_email
# In the demo, every email goes to this inbox and names who it was for, since sandbox addresses are made up.
NOTIFY_INBOX=

# Daily AI limits: per account for drafting checks, rewriting them and test runs, and overall across all accounts.
AI_LIMIT_DRAFT=8
AI_LIMIT_REWRITE=20
AI_LIMIT_VERIFY=6
AI_LIMIT_TOTAL=150
