{
  "name": "handovr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local src/db/migrate.ts",
    "db:seed": "tsx --env-file=.env.local src/db/seed.ts",
    "db:start": "LC_ALL=C pg_ctl -D .pgdata -o \"-p 5433 -c listen_addresses=localhost\" -l .pgdata/server.log start",
    "db:stop": "pg_ctl -D .pgdata stop",
    "demo:advance": "tsx --env-file=.env.local scripts/advance.ts",
    "db:studio": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@onkernel/sdk": "^0.117.0",
    "drizzle-orm": "^0.45.3",
    "material-symbols": "^0.47.6",
    "next": "16.3.8",
    "playwright-core": "^1.63.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.29.3"
}
